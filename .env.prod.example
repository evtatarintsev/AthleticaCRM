# Репозиторий GitHub (owner/repo) — используется для pull образов из ghcr.io
GITHUB_REPOSITORY=evtatarintsev/athleticacrm

# Основной домен: лендинг на нём, CRM на app.<домен>; прочие домены на сервере перенаправляются в CRM
DOMAIN=athleticacrm.ru

# PostgreSQL
POSTGRES_USER=athletica
POSTGRES_PASSWORD=CHANGE_ME

# JWT — случайная строка от 64 символов, например: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# MinIO (S3-совместимое хранилище)
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=athletica-crm
MINIO_PUBLIC_ENDPOINT=https://minio.athleticacrm.ru

# SMTP (исходящая почта)
SMTP_HOST=smtp.example.com
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=noreply@athleticacrm.ru
SENTRY_DSN="https://secret@app.glitchtip.com/<proj>"

YOOKASSA_SHOP_ID=642883
YOOKASSA_SECRET_KEY=""
YOOKASSA_TEST_MODE=false
YOOKASSA_RETURN_URL=https://app.athleticacrm.ru/settings/org-balance/complete

# Прокси для Telegram Bot API: URL через запятую (http:// или socks5://, логин:пароль@ необязательны).
# Пусто — прямой доступ.
TELEGRAM_PROXIES="socks5://user:pass@proxy.example.com:1080,http://proxy2.example.com:3128"

# Общее AI-подключение (необязательно): openai, anthropic или openrouter.
# Без всех трёх параметров CRM работает с недоступным помощником.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
