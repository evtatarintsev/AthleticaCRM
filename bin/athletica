#!/bin/sh
# Пересобирает athletica.jar (молча, если всё актуально) и запускает его с переданными аргументами.
# Опции JVM — из JAVA_OPTS.
root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/gradlew" -p "$root" -q --console=plain :server:shadowJar >&2 || exit 1
exec java $JAVA_OPTS -jar "$root/server/build/libs/athletica.jar" "$@"
