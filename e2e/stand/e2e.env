# Тестовые значения стенда e2e (e2e/stand/docker-compose.e2e.yaml). Секретов здесь нет и быть не должно.
GITHUB_REPOSITORY=athletica/e2e
DOMAIN=e2e.test
CRM_PUBLIC_URL=https://app.e2e.test

POSTGRES_USER=athletica
POSTGRES_PASSWORD=e2e

JWT_SECRET=e2e-jwt-secret-e2e-jwt-secret-e2e-jwt-secret-e2e-jwt-secret-0000

MINIO_ACCESS_KEY=e2e-access-key
MINIO_SECRET_KEY=e2e-secret-key
MINIO_BUCKET=athletica-crm
MINIO_PUBLIC_ENDPOINT=https://minio.e2e.test

SMTP_HOST=mailpit
SMTP_USERNAME=e2e
SMTP_PASSWORD=e2e
SMTP_FROM_ADDRESS=robot@e2e.test

YOOKASSA_SHOP_ID=e2e
YOOKASSA_SECRET_KEY=e2e
YOOKASSA_TEST_MODE=true
YOOKASSA_RETURN_URL=https://app.e2e.test/settings/org-balance/complete

AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
TELEGRAM_PROXIES=
