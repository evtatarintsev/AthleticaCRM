FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /build
COPY . .
RUN chmod +x gradlew && ./gradlew :server:shadowJar --no-daemon

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/server/build/libs/athletica.jar athletica.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "athletica.jar"]
CMD ["serve"]
