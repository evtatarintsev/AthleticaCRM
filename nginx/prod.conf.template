# Раскладка хостов (openspec public-site):
#   ${DOMAIN}              — публичный лендинг
#   app.${DOMAIN}          — CRM: SPA + REST API
#   clients.${DOMAIN}      — кабинет клиента: SPA + только /api/client-app/
#   www.${DOMAIN}          — 301 на ${DOMAIN}
#   любой другой хост      — 301 на тот же путь в app.${DOMAIN}
# Все имена должны быть в SAN сертификата ${DOMAIN} (scripts/renew-certificates.sh).

# HTTP: ACME challenge для Let's Encrypt, всё остальное — на HTTPS того же хоста
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: прочие хосты — перенаправление в CRM
server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://app.${DOMAIN}$request_uri;
}

# HTTPS: www — на основной домен
server {
    listen 443 ssl;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://${DOMAIN}$request_uri;
}

# HTTPS: основной домен — публичный лендинг
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Вход и регистрация живут в CRM
    location = /login {
        return 302 https://app.${DOMAIN}$request_uri;
    }

    location = /sign-up {
        return 302 https://app.${DOMAIN}$request_uri;
    }

    location / {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://frontend:8081;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
    }
}

# HTTPS: CRM — SPA + REST API (включая webhook ЮKassa /api/checkout/yookassa)
server {
    listen 443 ssl;
    server_name app.${DOMAIN};

    # Загрузка файлов до 10 МБ: импорт таблиц и фото журнала
    client_max_body_size 11m;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # CRM закрыта от поисковиков целиком
    add_header X-Robots-Tag "noindex, nofollow" always;
    # Страницы CRM нельзя встраивать в чужие сайты; исключение — виджет расписания ниже
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # Ход помощника с вложениями длится до 180 с (распознавание фото и подготовка импорта)
    location /api/assistant/ {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://server:8080;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 190s;
    }

    location /api/ {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://server:8080;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Публичный виджет расписания встраивается в iframe на любом сайте.
    # add_header здесь отменяет заголовки уровня server, поэтому X-Robots-Tag повторён.
    location /widget/ {
        add_header Content-Security-Policy "frame-ancestors *" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://frontend:80;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
    }

    # Веб-фронтенд (React)
    location / {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://frontend:80;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
    }
}

# Лимит по IP на вход в кабинет клиента: запрос кода и вход (design client-cabinet-web, §8).
# refresh под лимит не попадает: за одним IP (Wi-Fi зала) живёт много сеансов, а отказ в
# обновлении выкинул бы клиента из кабинета.
limit_req_zone $binary_remote_addr zone=client_app_auth:10m rate=10r/m;

# HTTPS: кабинет клиента — SPA + клиентское API. Маршруты CRM здесь не проксируются.
server {
    listen 443 ssl;
    server_name clients.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Кабинет закрыт от поисковиков и не встраивается в чужие сайты
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    location ~ ^/api/client-app/auth/(request-code|login)$ {
        limit_req          zone=client_app_auth burst=10 nodelay;
        limit_req_status   429;
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://server:8080;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /api/client-app/ {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://server:8080;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Остальное API (CRM, /api/client-app-admin/) с хоста кабинета недоступно
    location /api/ {
        return 404;
    }

    location / {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://cabinet:80;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
    }
}

# HTTPS: S3 API RustFS (используется для presigned URL)
server {
    listen 443 ssl;
    server_name minio.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 100m;

    location / {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://rustfs:9000;
        proxy_pass         $upstream;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_buffering    off;
    }
}

# HTTPS: веб-консоль RustFS
server {
    listen 443 ssl;
    server_name console.minio.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        resolver           127.0.0.11 valid=10s;
        set $upstream      http://rustfs:9001;
        proxy_pass         $upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
    }
}
